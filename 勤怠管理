<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>シフト・勤怠管理｜名倉・竹村・脇田</title>
<style>
:root{
  color-scheme: light;
  --surface-1:#fcfcfb;
  --plane:#f9f9f7;
  --text-primary:#0b0b0b;
  --text-secondary:#52514e;
  --muted:#898781;
  --grid:#e1e0d9;
  --axis:#c3c2b7;
  --border:rgba(11,11,11,0.10);
  --shadow:0 1px 2px rgba(11,11,11,.05), 0 8px 24px rgba(11,11,11,.05);
  --series-1:#2a78d6;
  --series-2:#eb6834;
  --series-3:#1baf7a;
  --hover:rgba(11,11,11,0.04);
  --weekend:rgba(42,120,214,0.045);
  --sunday:rgba(227,73,72,0.05);
  --today:rgba(237,161,0,0.12);
  --good:#006300;
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --surface-1:#1a1a19;
  --plane:#0d0d0d;
  --text-primary:#ffffff;
  --text-secondary:#c3c2b7;
  --muted:#898781;
  --grid:#2c2c2a;
  --axis:#383835;
  --border:rgba(255,255,255,0.10);
  --shadow:none;
  --series-1:#3987e5;
  --series-2:#d95926;
  --series-3:#199e70;
  --hover:rgba(255,255,255,0.06);
  --weekend:rgba(57,135,229,0.10);
  --sunday:rgba(230,103,103,0.10);
  --today:rgba(201,133,0,0.20);
  --good:#0ca30c;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--plane);
  color:var(--text-primary);
  font-family:system-ui,-apple-system,"Segoe UI","Hiragino Sans","Noto Sans JP",sans-serif;
  font-size:14px;line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1180px;margin:0 auto;padding:20px 20px 64px}
h1{font-size:19px;margin:0;letter-spacing:.01em}
h2{font-size:14px;margin:0 0 14px;color:var(--text-secondary);font-weight:600;letter-spacing:.02em}
.sub{color:var(--muted);font-size:12px;margin-top:2px}

/* ---------- header ---------- */
header{
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;
  padding:16px 18px;margin-bottom:16px;
  background:var(--surface-1);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);
}
.brand{display:flex;align-items:center;gap:12px;margin-right:auto}
.logo{
  width:38px;height:38px;border-radius:11px;flex:none;
  background:var(--series-1);color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px;
}
.monthnav{display:flex;align-items:center;gap:6px}
.monthlabel{font-size:17px;font-weight:700;min-width:9.5em;text-align:center;font-variant-numeric:tabular-nums}
.wage-badge{
  display:flex;align-items:baseline;gap:6px;padding:7px 13px;border-radius:999px;
  border:1px solid var(--border);background:var(--plane);font-size:12px;color:var(--text-secondary);
}
.wage-badge b{font-size:14px;color:var(--text-primary);font-variant-numeric:tabular-nums}

button{
  font:inherit;color:var(--text-primary);background:var(--surface-1);
  border:1px solid var(--border);border-radius:9px;padding:7px 13px;cursor:pointer;
  transition:background .12s ease,border-color .12s ease;
}
button:hover{background:var(--hover)}
button:active{transform:translateY(.5px)}
button.icon{padding:7px 11px;font-size:15px;line-height:1}
button.primary{background:var(--series-1);border-color:transparent;color:#fff}
button.primary:hover{filter:brightness(1.07);background:var(--series-1)}
button.ghost{background:transparent}
button:disabled{opacity:.4;cursor:not-allowed}

/* ---------- cards ---------- */
.card{
  background:var(--surface-1);border:1px solid var(--border);border-radius:14px;
  padding:18px;box-shadow:var(--shadow);margin-bottom:16px;
}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}
.stat{
  background:var(--surface-1);border:1px solid var(--border);border-radius:14px;
  padding:16px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.stat::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--c)}
.stat .who{display:flex;align-items:center;gap:8px;font-weight:700;font-size:15px}
.dot{display:inline-block;width:10px;height:10px;border-radius:3px;background:var(--c);flex:none;vertical-align:middle}
.big{font-size:32px;font-weight:700;letter-spacing:-.02em;line-height:1.15;margin-top:10px}
.big small{font-size:14px;font-weight:600;color:var(--text-secondary);margin-left:3px}
.pay{font-size:20px;font-weight:700;margin-top:2px;font-variant-numeric:tabular-nums}
.meta{display:flex;gap:14px;color:var(--text-secondary);font-size:12px;margin-top:8px;flex-wrap:wrap}
.meter{height:6px;border-radius:999px;background:var(--grid);margin-top:12px;overflow:hidden}
.meter i{display:block;height:100%;border-radius:999px;background:var(--c)}

.totalbar{
  display:flex;align-items:center;gap:10px 28px;flex-wrap:wrap;
  padding:14px 18px;border-radius:14px;border:1px solid var(--border);
  background:var(--surface-1);box-shadow:var(--shadow);margin-bottom:16px;
}
.totalbar .t{color:var(--text-secondary);font-size:12px}
.totalbar .v{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums}

/* ---------- chart ---------- */
.chartwrap{position:relative}
.legend{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:6px}
.legend span{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--text-secondary)}
.tooltip{
  position:absolute;pointer-events:none;opacity:0;transform:translate(-50%,-100%);
  background:var(--surface-1);border:1px solid var(--border);border-radius:10px;
  padding:9px 11px;font-size:12px;box-shadow:0 4px 16px rgba(0,0,0,.18);
  white-space:nowrap;transition:opacity .1s ease;z-index:5;
}
.tooltip .th{font-weight:700;margin-bottom:5px}
.tooltip .tr{display:flex;align-items:center;gap:8px;justify-content:space-between}
.tooltip .tr b{font-variant-numeric:tabular-nums;font-weight:600}

/* ---------- tabs ---------- */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.tab{
  padding:8px 16px;border-radius:999px;border:1px solid var(--border);
  background:var(--surface-1);cursor:pointer;font-size:13px;font-weight:600;
  display:flex;align-items:center;gap:8px;
}
.tab[aria-selected="true"]{background:var(--text-primary);color:var(--surface-1);border-color:transparent}
.tab[aria-selected="true"] .dot{box-shadow:0 0 0 2px var(--surface-1)}

/* ---------- bulk ---------- */
.bulk{
  display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;
  padding:12px 14px;border:1px dashed var(--border);border-radius:12px;margin-bottom:14px;background:var(--plane);
}
.field{display:flex;flex-direction:column;gap:4px}
.field label{font-size:11px;color:var(--muted)}
input[type=time],input[type=number],input[type=text],select{
  font:inherit;color:var(--text-primary);background:var(--surface-1);
  border:1px solid var(--border);border-radius:8px;padding:5px 8px;
  font-variant-numeric:tabular-nums;
}
input:focus,select:focus{outline:2px solid var(--series-1);outline-offset:1px}

/* ---------- table ---------- */
.tablescroll{overflow-x:auto;border:1px solid var(--border);border-radius:12px}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:13px}
th,td{padding:6px 10px;text-align:left;white-space:nowrap}
thead th{
  position:sticky;top:0;z-index:2;background:var(--surface-1);
  font-size:11px;color:var(--muted);font-weight:600;border-bottom:1px solid var(--border);
}
tbody tr{border-top:1px solid var(--grid)}
tbody tr:first-child{border-top:none}
tbody tr:hover{background:var(--hover)}
tr.sat{background:var(--weekend)}
tr.sun{background:var(--sunday)}
tr.today td:first-child{box-shadow:inset 3px 0 0 var(--series-1)}
tr.today{background:var(--today)}
td.date{font-variant-numeric:tabular-nums;font-weight:600;width:60px}
td.dow{color:var(--text-secondary);width:38px}
td.num{font-variant-numeric:tabular-nums;text-align:right;font-weight:600}
td.num.zero{color:var(--muted);font-weight:400}
tfoot td{
  border-top:2px solid var(--axis);font-weight:700;background:var(--surface-1);
  position:sticky;bottom:0;font-variant-numeric:tabular-nums;
}
input.t{width:132px}
input.b{width:74px;text-align:right}
input.memo{width:150px;border-color:transparent;background:transparent}
input.memo:hover{border-color:var(--border)}
.pill{display:inline-block;padding:1px 7px;border-radius:999px;font-size:11px;background:var(--plane);border:1px solid var(--border);color:var(--text-secondary)}

/* ---------- footer ---------- */
footer{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:18px}
.savenote{color:var(--muted);font-size:12px;margin-left:auto}
.toast{
  position:fixed;left:50%;bottom:26px;transform:translate(-50%,12px);
  background:var(--text-primary);color:var(--surface-1);padding:10px 18px;border-radius:999px;
  font-size:13px;opacity:0;transition:.2s ease;pointer-events:none;z-index:50;
}
.toast.on{opacity:1;transform:translate(-50%,0)}

@media (max-width:820px){
  .stats{grid-template-columns:1fr}
  .monthlabel{min-width:8em;font-size:15px}
}
@media print{
  body{background:#fff}
  .bulk,footer,.tabs,button,.savenote{display:none!important}
  .card,.stat,.totalbar,header{box-shadow:none;break-inside:avoid}
  .wrap{max-width:none;padding:0}
}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="brand">
    <div class="logo">勤</div>
    <div>
      <h1>シフト・勤怠管理</h1>
      <div class="sub">名倉 ・ 竹村 ・ 脇田</div>
    </div>
  </div>
  <div class="monthnav">
    <button class="icon" id="prev" title="前の月">◀</button>
    <div class="monthlabel" id="monthLabel">—</div>
    <button class="icon" id="next" title="次の月">▶</button>
    <button class="ghost" id="today">今月</button>
  </div>
  <div class="wage-badge">時給 <b>¥2,000</b></div>
  <button class="icon" id="theme" title="表示テーマの切替">◐</button>
</header>

<!-- 集計カード -->
<section class="stats" id="stats"></section>

<div class="totalbar">
  <div><div class="t">3人合計 労働時間</div><div class="v" id="grandHours">—</div></div>
  <div><div class="t">3人合計 給与</div><div class="v" id="grandPay">—</div></div>
  <div><div class="t">延べ出勤日数</div><div class="v" id="grandDays">—</div></div>
  <div><div class="t">対象月</div><div class="v" id="grandMonth">—</div></div>
</div>

<!-- グラフ -->
<section class="card">
  <h2>日別の実働時間</h2>
  <div class="legend" id="legend"></div>
  <div class="chartwrap" id="chartwrap">
    <svg id="chart" role="img" aria-label="日別の実働時間の棒グラフ"></svg>
    <div class="tooltip" id="tip"></div>
  </div>
</section>

<!-- 入力 -->
<section class="card">
  <h2>シフト入力</h2>
  <div class="tabs" id="tabs"></div>

  <div class="bulk" id="bulk">
    <div class="field"><label>対象</label>
      <select id="bTarget">
        <option value="weekday">平日のみ</option>
        <option value="all">全日</option>
        <option value="weekend">土日のみ</option>
      </select>
    </div>
    <div class="field"><label>開始</label><input type="time" id="bStart" class="t" value="09:00"></div>
    <div class="field"><label>終了</label><input type="time" id="bEnd" class="t" value="18:00"></div>
    <div class="field"><label>休憩(分)</label><input type="number" id="bBreak" class="b" value="60" min="0" step="5"></div>
    <button class="primary" id="bApply">一括入力</button>
    <button id="bClear">この人の当月をクリア</button>
    <span class="sub" id="bulkNote"></span>
  </div>

  <div class="tablescroll" id="tablescroll"></div>
</section>

<footer>
  <button id="exportJson">バックアップを保存(JSON)</button>
  <button id="importJson">バックアップを読み込む</button>
  <button id="exportCsv">この月をCSV出力</button>
  <button id="print">印刷 / PDF</button>
  <input type="file" id="fileInput" accept="application/json,.json" hidden>
  <span class="savenote" id="saveNote"></span>
</footer>

</div>
<div class="toast" id="toast"></div>

<script>
(function(){
"use strict";

/* ============ 設定 ============ */
var WAGE = 2000; // 時給(円)
var PEOPLE = [
  {id:"nagura",  name:"名倉", color:"var(--series-1)", raw:["#2a78d6","#3987e5"]},
  {id:"takemura",name:"竹村", color:"var(--series-2)", raw:["#eb6834","#d95926"]},
  {id:"wakita",  name:"脇田", color:"var(--series-3)", raw:["#1baf7a","#199e70"]}
];
var DOW = ["日","月","火","水","木","金","土"];
var STORE_KEY = "shift-manager-v1";

/* ============ 保存（ローカル保存が使えない環境ではメモリ保持） ============ */
var memoryStore = null, storageOK = true;
function loadAll(){
  try{
    var raw = window.localStorage.getItem(STORE_KEY);
    return raw ? JSON.parse(raw) : {};
  }catch(e){ storageOK = false; return memoryStore || {}; }
}
function saveAll(){
  memoryStore = state.data;
  try{
    window.localStorage.setItem(STORE_KEY, JSON.stringify(state.data));
    note("自動保存しました（このブラウザに保存）");
  }catch(e){
    storageOK = false;
    note("このブラウザには保存できません。JSONバックアップをご利用ください");
  }
}
function note(t){ document.getElementById("saveNote").textContent = t; }

/* ============ 状態 ============ */
var now = new Date();
var state = {
  y: now.getFullYear(),
  m: now.getMonth(),          // 0-11
  person: PEOPLE[0].id,       // "all" で全員表示
  data: loadAll()             // data[personId][ "YYYY-MM-DD" ] = {s,e,b,memo}
};

/* ============ ユーティリティ ============ */
function pad(n){ return (n<10?"0":"")+n; }
function key(y,m,d){ return y+"-"+pad(m+1)+"-"+pad(d); }
function daysInMonth(y,m){ return new Date(y,m+1,0).getDate(); }
function rec(pid,k){
  var p = state.data[pid]; if(!p) return null;
  return p[k] || null;
}
function setRec(pid,k,patch){
  if(!state.data[pid]) state.data[pid] = {};
  var cur = state.data[pid][k] || {s:"",e:"",b:"",memo:""};
  for(var q in patch) cur[q] = patch[q];
  if(!cur.s && !cur.e && !cur.memo && (cur.b===""||cur.b==null)) delete state.data[pid][k];
  else state.data[pid][k] = cur;
  saveAll();
}
function toMin(t){
  if(!t || t.indexOf(":")<0) return null;
  var a = t.split(":"); var h = parseInt(a[0],10), mi = parseInt(a[1],10);
  if(isNaN(h)||isNaN(mi)) return null;
  return h*60+mi;
}
// 実働分数（終了が開始より前なら日跨ぎとして扱う。休憩を差し引き、マイナスは0）
function workMin(r){
  if(!r) return 0;
  var s = toMin(r.s), e = toMin(r.e);
  if(s===null || e===null) return 0;
  var d = e - s; if(d <= 0) d += 24*60;
  var b = parseInt(r.b,10); if(isNaN(b)||b<0) b = 0;
  return Math.max(0, d - b);
}
function hm(min){ return Math.floor(min/60)+":"+pad(min%60); }
function hours(min){ return min/60; }
function fmtH(min){
  var h = hours(min);
  return (Math.round(h*100)/100).toFixed(h % 1 === 0 ? 0 : (Math.round(h*100)%10===0?1:2));
}
function yen(n){ return "¥" + Math.round(n).toLocaleString("ja-JP"); }
// 法定に沿った休憩の初期値（6h超=45分 / 8h超=60分）
function suggestBreak(s,e){
  var a = toMin(s), b = toMin(e); if(a===null||b===null) return null;
  var d = b-a; if(d<=0) d += 24*60;
  if(d > 8*60) return 60;
  if(d > 6*60) return 45;
  return 0;
}
function isToday(y,m,d){
  var t = new Date();
  return t.getFullYear()===y && t.getMonth()===m && t.getDate()===d;
}
function toast(msg){
  var el = document.getElementById("toast");
  el.textContent = msg; el.classList.add("on");
  clearTimeout(toast._t); toast._t = setTimeout(function(){ el.classList.remove("on"); },1900);
}

/* ============ 集計 ============ */
function monthSeries(){
  var n = daysInMonth(state.y, state.m);
  var out = {days:[], byPerson:{}};
  PEOPLE.forEach(function(p){ out.byPerson[p.id] = {min:0, days:0, list:[]}; });
  for(var d=1; d<=n; d++){
    var k = key(state.y,state.m,d);
    var row = {d:d, k:k, dow:new Date(state.y,state.m,d).getDay(), vals:{}, total:0};
    PEOPLE.forEach(function(p){
      var w = workMin(rec(p.id,k));
      row.vals[p.id] = w; row.total += w;
      out.byPerson[p.id].min += w;
      out.byPerson[p.id].list.push(w);
      if(w>0) out.byPerson[p.id].days++;
    });
    out.days.push(row);
  }
  return out;
}

/* ============ 描画：集計カード ============ */
function renderStats(S){
  var max = 0;
  PEOPLE.forEach(function(p){ max = Math.max(max, S.byPerson[p.id].min); });
  var html = PEOPLE.map(function(p){
    var b = S.byPerson[p.id];
    var pay = hours(b.min) * WAGE;
    var avg = b.days ? b.min/b.days : 0;
    return '<div class="stat" style="--c:'+p.color+'">'
      + '<div class="who"><span class="dot"></span>'+p.name+'</div>'
      + '<div class="big">'+fmtH(b.min)+'<small>時間</small>'
      + (b.min%60 ? ' <span class="pill">'+hm(b.min)+'</span>' : '')+'</div>'
      + '<div class="pay">'+yen(pay)+'</div>'
      + '<div class="meta"><span>出勤 '+b.days+'日</span><span>1日平均 '+fmtH(avg)+'h</span><span>時給 ¥2,000</span></div>'
      + '<div class="meter"><i style="width:'+(max? (b.min/max*100):0)+'%"></i></div>'
      + '</div>';
  }).join("");
  document.getElementById("stats").innerHTML = html;

  var tm = 0, td = 0;
  PEOPLE.forEach(function(p){ tm += S.byPerson[p.id].min; td += S.byPerson[p.id].days; });
  document.getElementById("grandHours").textContent = fmtH(tm)+" 時間" + (tm%60? "（"+hm(tm)+"）":"");
  document.getElementById("grandPay").textContent = yen(hours(tm)*WAGE);
  document.getElementById("grandDays").textContent = td+" 日";
  document.getElementById("grandMonth").textContent = state.y+"年"+(state.m+1)+"月";
}

/* ============ 描画：グラフ ============ */
function roundedTop(x,y,w,h,r){
  if(h<=0) return "";
  r = Math.min(r, w/2, h);
  return "M"+x+","+(y+h)+"V"+(y+r)+"Q"+x+","+y+" "+(x+r)+","+y
       + "H"+(x+w-r)+"Q"+(x+w)+","+y+" "+(x+w)+","+(y+r)+"V"+(y+h)+"Z";
}
function renderLegend(){
  document.getElementById("legend").innerHTML = PEOPLE.map(function(p){
    return '<span><i class="dot" style="background:'+p.color+'"></i>'+p.name+'</span>';
  }).join("");
}
function renderChart(S){
  var wrap = document.getElementById("chartwrap");
  var svg = document.getElementById("chart");
  var W = Math.max(320, wrap.clientWidth);
  var H = 250, padL = 42, padR = 10, padT = 12, padB = 26;
  var plotW = W - padL - padR, plotH = H - padT - padB;

  var maxV = 0;
  S.days.forEach(function(r){ PEOPLE.forEach(function(p){ maxV = Math.max(maxV, r.vals[p.id]); }); });
  var maxH = Math.max(8, Math.ceil(hours(maxV)));
  if(maxH % 2) maxH += 1;
  var step = maxH <= 12 ? 2 : (maxH <= 24 ? 4 : 6);

  var n = S.days.length;
  var slot = plotW / n;
  var gap = 2;                                  // 隣接バーの間は必ず2pxの下地
  var barW = Math.max(2, (slot - 6 - gap*(PEOPLE.length-1)) / PEOPLE.length);

  var parts = [];
  // グリッド
  for(var v=0; v<=maxH; v+=step){
    var gy = padT + plotH - (v/maxH)*plotH;
    parts.push('<line x1="'+padL+'" x2="'+(W-padR)+'" y1="'+gy+'" y2="'+gy+'" stroke="var(--grid)" stroke-width="1"/>');
    parts.push('<text x="'+(padL-8)+'" y="'+(gy+4)+'" text-anchor="end" font-size="10" fill="var(--muted)">'+v+'h</text>');
  }
  // バー
  S.days.forEach(function(r,i){
    var x0 = padL + i*slot + 3;
    PEOPLE.forEach(function(p,j){
      var val = r.vals[p.id]; if(!val) return;
      var h = (hours(val)/maxH) * plotH;
      var x = x0 + j*(barW+gap);
      var y = padT + plotH - h;
      parts.push('<path d="'+roundedTop(x,y,barW,h,4)+'" fill="'+p.color+'"/>');
    });
    // 日付ラベル（幅に応じて間引き）
    var everyN = slot < 15 ? 5 : (slot < 22 ? 2 : 1);
    if(r.d === 1 || r.d % everyN === 0){
      parts.push('<text x="'+(padL+i*slot+slot/2)+'" y="'+(H-8)+'" text-anchor="middle" font-size="10" fill="var(--muted)">'+r.d+'</text>');
    }
    // ホバー領域
    parts.push('<rect class="hit" data-i="'+i+'" x="'+(padL+i*slot)+'" y="'+padT+'" width="'+slot+'" height="'+plotH+'" fill="transparent"/>');
  });
  // ベースライン
  parts.push('<line x1="'+padL+'" x2="'+(W-padR)+'" y1="'+(padT+plotH)+'" y2="'+(padT+plotH)+'" stroke="var(--axis)" stroke-width="1"/>');

  svg.setAttribute("width", W);
  svg.setAttribute("height", H);
  svg.innerHTML = parts.join("");

  // ツールチップ
  var tip = document.getElementById("tip");
  svg.onmousemove = function(ev){
    var t = ev.target;
    if(!t.classList || !t.classList.contains("hit")){ tip.style.opacity = 0; return; }
    var r = S.days[+t.getAttribute("data-i")];
    if(!r.total){ tip.style.opacity = 0; return; }
    tip.innerHTML = '<div class="th">'+(state.m+1)+'/'+r.d+'（'+DOW[r.dow]+'）</div>'
      + PEOPLE.map(function(p){
          return '<div class="tr"><span><i class="dot" style="background:'+p.color+'"></i> '+p.name+'</span><b>'
            + (r.vals[p.id] ? hm(r.vals[p.id]) : "—")+'</b></div>';
        }).join("")
      + '<div class="tr" style="margin-top:5px;border-top:1px solid var(--border);padding-top:5px"><span>日計</span><b>'+hm(r.total)+'</b></div>';
    var rect = wrap.getBoundingClientRect();
    tip.style.left = (ev.clientX - rect.left) + "px";
    tip.style.top  = (ev.clientY - rect.top - 14) + "px";
    tip.style.opacity = 1;
  };
  svg.onmouseleave = function(){ tip.style.opacity = 0; };
}

/* ============ 描画：タブ ============ */
function renderTabs(){
  var html = PEOPLE.map(function(p){
    return '<button class="tab" role="tab" data-p="'+p.id+'" aria-selected="'+(state.person===p.id)+'">'
      + '<i class="dot" style="background:'+p.color+'"></i>'+p.name+'</button>';
  }).join("");
  html += '<button class="tab" role="tab" data-p="all" aria-selected="'+(state.person==="all")+'">全員まとめて表示</button>';
  document.getElementById("tabs").innerHTML = html;
  var isAll = state.person === "all";
  document.getElementById("bulk").style.display = isAll ? "none" : "flex";
  document.getElementById("bulkNote").textContent = isAll ? "" :
    "※ 入力済みの日は上書きされます";
}

/* ============ 描画：テーブル ============ */
function renderTable(S){
  var box = document.getElementById("tablescroll");
  box.innerHTML = (state.person === "all") ? tableAll(S) : tablePerson(S, state.person);
}
function rowClass(r){
  var c = [];
  if(r.dow===0) c.push("sun"); else if(r.dow===6) c.push("sat");
  if(isToday(state.y,state.m,r.d)) c.push("today");
  return c.join(" ");
}
function tablePerson(S, pid){
  var p = PEOPLE.filter(function(x){return x.id===pid;})[0];
  var b = S.byPerson[pid];
  var rows = S.days.map(function(r){
    var rc = rec(pid, r.k) || {s:"",e:"",b:"",memo:""};
    var w = r.vals[pid];
    return '<tr class="'+rowClass(r)+'">'
      + '<td class="date">'+(state.m+1)+'/'+r.d+'</td>'
      + '<td class="dow">'+DOW[r.dow]+'</td>'
      + '<td><input class="t" type="time" data-k="'+r.k+'" data-f="s" value="'+(rc.s||"")+'"></td>'
      + '<td><input class="t" type="time" data-k="'+r.k+'" data-f="e" value="'+(rc.e||"")+'"></td>'
      + '<td><input class="b" type="number" min="0" step="5" data-k="'+r.k+'" data-f="b" value="'+(rc.b===0?0:(rc.b||""))+'"></td>'
      + '<td class="num'+(w?"":" zero")+'">'+(w? hm(w):"—")+'</td>'
      + '<td class="num'+(w?"":" zero")+'">'+(w? yen(hours(w)*WAGE):"—")+'</td>'
      + '<td><input class="memo" type="text" placeholder="メモ" data-k="'+r.k+'" data-f="memo" value="'+String(rc.memo||"").replace(/"/g,"&quot;")+'"></td>'
      + '</tr>';
  }).join("");
  return '<table><thead><tr>'
    + '<th>日付</th><th>曜</th><th>開始</th><th>終了</th><th>休憩(分)</th><th style="text-align:right">実働</th><th style="text-align:right">給与</th><th>メモ</th>'
    + '</tr></thead><tbody id="tbody">'+rows+'</tbody>'
    + '<tfoot><tr><td colspan="5">'+p.name+' 合計（出勤 '+b.days+'日）</td>'
    + '<td class="num">'+hm(b.min)+'</td><td class="num">'+yen(hours(b.min)*WAGE)+'</td><td></td></tr></tfoot></table>';
}
function tableAll(S){
  var head = '<tr><th>日付</th><th>曜</th>'
    + PEOPLE.map(function(p){ return '<th><i class="dot" style="background:'+p.color+';display:inline-block;margin-right:5px"></i>'+p.name+'</th><th style="text-align:right">実働</th>'; }).join("")
    + '<th style="text-align:right">日計</th></tr>';
  var rows = S.days.map(function(r){
    return '<tr class="'+rowClass(r)+'">'
      + '<td class="date">'+(state.m+1)+'/'+r.d+'</td><td class="dow">'+DOW[r.dow]+'</td>'
      + PEOPLE.map(function(p){
          var rc = rec(p.id,r.k), w = r.vals[p.id];
          var span = (rc && rc.s && rc.e) ? (rc.s+"–"+rc.e+(rc.b? " <span class='pill'>休"+rc.b+"</span>":"")) : "—";
          return '<td'+(w?"":' class="num zero" style="text-align:left"')+'>'+span+'</td>'
               + '<td class="num'+(w?"":" zero")+'">'+(w? hm(w):"—")+'</td>';
        }).join("")
      + '<td class="num'+(r.total?"":" zero")+'">'+(r.total? hm(r.total):"—")+'</td></tr>';
  }).join("");
  var tm = 0; PEOPLE.forEach(function(p){ tm += S.byPerson[p.id].min; });
  var foot = '<tr><td colspan="2">合計</td>'
    + PEOPLE.map(function(p){
        var b = S.byPerson[p.id];
        return '<td>'+yen(hours(b.min)*WAGE)+'</td><td class="num">'+hm(b.min)+'</td>';
      }).join("")
    + '<td class="num">'+hm(tm)+'</td></tr>';
  return '<table><thead>'+head+'</thead><tbody>'+rows+'</tbody><tfoot>'+foot+'</tfoot></table>';
}

/* ============ 全体再描画 ============ */
function render(){
  document.getElementById("monthLabel").textContent = state.y+"年 "+(state.m+1)+"月";
  var S = monthSeries();
  renderStats(S);
  renderLegend();
  renderChart(S);
  renderTabs();
  renderTable(S);
}

/* ============ イベント ============ */
document.getElementById("prev").onclick = function(){ state.m--; if(state.m<0){state.m=11;state.y--;} render(); };
document.getElementById("next").onclick = function(){ state.m++; if(state.m>11){state.m=0;state.y++;} render(); };
document.getElementById("today").onclick = function(){ var t=new Date(); state.y=t.getFullYear(); state.m=t.getMonth(); render(); };
document.getElementById("theme").onclick = function(){
  var d = document.documentElement;
  d.setAttribute("data-theme", d.getAttribute("data-theme")==="dark" ? "light" : "dark");
  render();
};
document.getElementById("tabs").addEventListener("click", function(ev){
  var b = ev.target.closest("[data-p]"); if(!b) return;
  state.person = b.getAttribute("data-p"); render();
});

// 表の入力（変更されたら保存 → 再計算）
document.getElementById("tablescroll").addEventListener("change", function(ev){
  var el = ev.target; var k = el.getAttribute("data-k"); if(!k) return;
  var f = el.getAttribute("data-f");
  var patch = {}; patch[f] = (f==="b") ? (el.value===""? "" : Math.max(0, parseInt(el.value,10)||0)) : el.value;
  var pid = state.person;
  // 開始・終了が揃って休憩が未入力なら、法定に沿った休憩を自動で入れる
  if(f==="s" || f==="e"){
    var cur = rec(pid,k) || {};
    var s = f==="s" ? el.value : cur.s, e = f==="e" ? el.value : cur.e;
    if(s && e && (cur.b===undefined || cur.b==="" || cur.b===null)){
      var sg = suggestBreak(s,e); if(sg!==null) patch.b = sg;
    }
  }
  setRec(pid, k, patch);
  render();
});

// 一括入力
document.getElementById("bApply").onclick = function(){
  var t = document.getElementById("bTarget").value;
  var s = document.getElementById("bStart").value, e = document.getElementById("bEnd").value;
  var b = parseInt(document.getElementById("bBreak").value,10) || 0;
  if(!s || !e){ toast("開始と終了の時刻を入力してください"); return; }
  var n = daysInMonth(state.y,state.m), cnt = 0;
  for(var d=1; d<=n; d++){
    var dow = new Date(state.y,state.m,d).getDay();
    var isWe = (dow===0 || dow===6);
    if(t==="weekday" && isWe) continue;
    if(t==="weekend" && !isWe) continue;
    setRec(state.person, key(state.y,state.m,d), {s:s, e:e, b:b});
    cnt++;
  }
  render(); toast(cnt+"日分を入力しました");
};
document.getElementById("bClear").onclick = function(){
  var p = PEOPLE.filter(function(x){return x.id===state.person;})[0];
  if(!confirm(state.y+"年"+(state.m+1)+"月の「"+p.name+"」の入力をすべて消します。よろしいですか？")) return;
  var n = daysInMonth(state.y,state.m);
  for(var d=1; d<=n; d++){
    if(state.data[state.person]) delete state.data[state.person][key(state.y,state.m,d)];
  }
  saveAll(); render(); toast("当月の入力を消去しました");
};

// 書き出し / 読み込み
function download(name, text, mime){
  var blob = new Blob([text], {type:mime||"text/plain;charset=utf-8"});
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 500);
}
document.getElementById("exportJson").onclick = function(){
  download("勤怠データ_バックアップ.json",
    JSON.stringify({version:1, wage:WAGE, people:PEOPLE.map(function(p){return {id:p.id,name:p.name};}), data:state.data}, null, 2),
    "application/json");
  toast("バックアップを保存しました");
};
document.getElementById("importJson").onclick = function(){ document.getElementById("fileInput").click(); };
document.getElementById("fileInput").onchange = function(ev){
  var f = ev.target.files[0]; if(!f) return;
  var fr = new FileReader();
  fr.onload = function(){
    try{
      var obj = JSON.parse(fr.result);
      if(!obj || !obj.data) throw new Error("形式が違います");
      if(!confirm("読み込むと現在のデータは置き換わります。よろしいですか？")) return;
      state.data = obj.data; saveAll(); render(); toast("読み込みました");
    }catch(err){ alert("このファイルは読み込めませんでした：" + err.message); }
  };
  fr.readAsText(f); ev.target.value = "";
};
document.getElementById("exportCsv").onclick = function(){
  var S = monthSeries();
  var lines = [];
  lines.push(["日付","曜日","氏名","開始","終了","休憩(分)","実働(時:分)","実働(時間)","給与(円)","メモ"].join(","));
  S.days.forEach(function(r){
    PEOPLE.forEach(function(p){
      var rc = rec(p.id,r.k); var w = r.vals[p.id];
      if(!rc && !w) return;
      lines.push([
        state.y+"/"+(state.m+1)+"/"+r.d, DOW[r.dow], p.name,
        (rc&&rc.s)||"", (rc&&rc.e)||"", (rc&&rc.b!==""&&rc.b!=null)?rc.b:"",
        w? hm(w):"", w? (Math.round(hours(w)*100)/100):"", w? Math.round(hours(w)*WAGE):"",
        '"'+String((rc&&rc.memo)||"").replace(/"/g,'""')+'"'
      ].join(","));
    });
  });
  lines.push("");
  PEOPLE.forEach(function(p){
    var b = S.byPerson[p.id];
    lines.push(["月計","","" + p.name,"","","",hm(b.min),Math.round(hours(b.min)*100)/100,Math.round(hours(b.min)*WAGE),""].join(","));
  });
  download(state.y+"年"+(state.m+1)+"月_勤怠.csv", "﻿"+lines.join("\r\n"), "text/csv;charset=utf-8");
  toast("CSVを保存しました");
};
document.getElementById("print").onclick = function(){ window.print(); };

var rt; window.addEventListener("resize", function(){
  clearTimeout(rt); rt = setTimeout(function(){ renderChart(monthSeries()); }, 120);
});

render();
note(storageOK ? "入力すると自動保存されます（このブラウザ内）" : "このブラウザには自動保存できません。JSONバックアップをご利用ください");

